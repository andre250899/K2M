# Build directories (ancorado na raiz: evita colisão case-insensitive com
# pastas de código como Source/Export/ no Windows - "export/" sem "/" na
# frente também ignoraria Source/Export/ em qualquer profundidade)
/build/
/bin/
/out/
/.cache/

# Visual Studio / IDE files
.vs/
*.sln
*.vcxproj*
*.user
.idea/
.vscode/

# Temporary and export artifacts generated at runtime (apenas na raiz do projeto)
/temp/
/logs/
/raw/
/processed/
/export/

# Ferramentas de terceiros baixadas para validação local (não redistribuir binários no repo)
external/sfizz_render/

# Saídas de takes manuais do GateATest.exe (não são fixture versionado, ver Tests/)
/gate_a_takes/
